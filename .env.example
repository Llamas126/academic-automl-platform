APP_DEBUG=false
DATA_DIR=data
MAX_UPLOAD_MB=200

# Redis (docker-compose exige REDIS_PASSWORD)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me-strong
JOB_STORE_BACKEND=redis
CELERY_EAGER=false

DEFAULT_RANDOM_STATE=42
FIGURES_DPI=300
SHAP_BACKGROUND_SAMPLES=100
SHAP_MAX_EVAL_ROWS=500
PDF_ENGINE=auto

CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=360
JOB_RETENTION_HOURS=168
UPLOAD_RETENTION_HOURS=168

# Seguridad (opt-in)
AUTH_ENABLED=false
API_KEYS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=
HSTS_ENABLED=false

# Limites de recursos
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=2000
PREDICT_MAX_RECORDS=50000
PREDICT_MAX_BODY_MB=64

# Integridad de artefactos: off | if_present | strict
ARTIFACT_INTEGRITY=if_present
ARTIFACT_SIGNING_KEY=
